# =============================================================================
# AI SDR - Environment Configuration
# =============================================================================

# Application
APP_ENV=development
APP_NAME=AI SDR
APP_SLUG=ai-sdr
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# PostgreSQL + pgvector (Docker Compose default)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/ai_sdr
# Local SQLite quickstart option (no Docker required):
# DATABASE_URL=sqlite+aiosqlite:///./ai_sdr.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis & Celery Background Execution
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
TASK_EXECUTION_MODE=inline

# LLM Routing & Embeddings
# "mock" (offline deterministic), "ollama", or "gemini"
LLM_DEFAULT_PROVIDER=mock
LLM_FALLBACK_PROVIDERS=ollama,gemini,mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama-3.1-8b-instruct
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIMENSIONS=384
LLM_REDACT_PII_FOR_CLOUD=true

# Outbound Email Delivery ("mock", "smtp", "resend", or "sendgrid")
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=sdr@acme-sdr.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=
SENDGRID_API_KEY=

# Outbound CRM Connectors ("mock", "hubspot", or "salesforce")
CRM_OUTBOUND_PROVIDER=mock
HUBSPOT_API_KEY=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# Security, Rate Limiting & Telemetry
# IMPORTANT: Override AUTH_SECRET_KEY in production with a unique >=32-byte secret.
AUTH_SECRET_KEY=dev-insecure-secret-change-in-production-32bytes
AUTH_REQUIRE_TOKEN=false
WEBHOOK_SIGNING_SECRET=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
OTEL_ENABLED=false
SEED_DEMO_DATA=false
